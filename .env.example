# Database
DATABASE_URL=sqlite:./data/footballterror.db
# DATABASE_URL=postgresql://user:password@localhost:5432/footballterror

# Redis (optional, for caching/streams later)
# REDIS_URL=redis://localhost:6379

# StatsBomb (not needed for open data)
# STATSBOMB_API_KEY=

# LLM Router
# LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_MODEL=gpt-4o-mini
# LLM_API_KEY=

# App
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Feature flags
AUTO_PUBLISH_ENABLED=false
