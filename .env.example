# ══════════════════════════════════════════════════════════════
# FootballTerror — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ══════════════════════════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://footballterror:changeme@localhost:5432/footballterror
# DATABASE_URL=sqlite:./data/footballterror.db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Sports Data APIs ────────────────────────────────────────
# api-football.com (100 req/day free tier)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.org (10 req/min free tier, delayed scores)
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# football-charts.com (5000 req/day, all leagues, probabilities + results)
FOOTBALL_CHARTS_KEY=
FOOTBALL_CHARTS_BASE_URL=https://footballcharts-backend.onrender.com/api/v1

# ─── Email (Hostinger SMTP) ──────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@footballterror.com
SMTP_PASS=
MAIL_FROM=no-reply@footballterror.com

# ─── LLM Providers ───────────────────────────────────────────
# Default provider/model for standard + heavy tasks
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=

OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Ordered fallback chains — MODEL1 is primary, others tried in order.
# Suffixes after MODEL<N>_ are ignored by the parser.
# NVIDIA chain = "small task" tier (rate-limited to 36 req/min, see docs/AGENTS.md)
OPENROUTER_MODEL1=
OPENROUTER_MODEL2=
OPENROUTER_MODEL3=
OPENROUTER_MODEL4=
NVIDIA_MODEL1=
NVIDIA_MODEL2=

# ─── Feature Flags ───────────────────────────────────────────
AUTO_PUBLISH_ENABLED=false
LIVE_DATA_ENABLED=false

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
