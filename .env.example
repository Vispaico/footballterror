# ══════════════════════════════════════════════════════════════
# FootballTerror — Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://footballterror:changeme@localhost:5432/footballterror
# SQLite (local dev fallback)
# DATABASE_URL=sqlite:./data/footballterror.db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_PORT=3000

# ─── API Keys ────────────────────────────────────────────────
# api-football.com (100 req/day free tier)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.org (10 req/min free tier, delayed scores)
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# ─── LLM Router ─────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_API_KEY=

# ─── Feature Flags ───────────────────────────────────────────
AUTO_PUBLISH_ENABLED=false
LIVE_DATA_ENABLED=false

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
