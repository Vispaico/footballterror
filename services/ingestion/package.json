{
  "name": "@footballterror/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@footballterror/football-schema": "workspace:*",
    "@footballterror/database": "workspace:*",
    "@footballterror/config": "workspace:*",
    "@footballterror/logger": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
